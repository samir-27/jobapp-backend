# Database configuration
MONGO_URI=mongodb://localhost:27017/jobdb

# Server port
PORT=3000

# Authentication secrets
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_at_least_32_chars

# Cloudinary configuration (required for file uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional admin bootstrap secret for creating the initial admin
ADMIN_BOOTSTRAP_SECRET=your_optional_admin_bootstrap_secret
