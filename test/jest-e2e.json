{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^cloudinary\\.config$": "<rootDir>/../cloudinary.config",
    "^src/(.*)$": "<rootDir>/../src/$1"
  }
}
